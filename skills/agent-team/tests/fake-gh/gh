#!/usr/bin/env python3
"""Stands in for the GitHub CLI in merge-gate tests.

Answers reads with the recorded JSON in $FAKE_GH_FIXTURE and appends every command that changes GitHub
(merge, update branch) to $FAKE_GH_WORK_DIR/writes.log. A fixture with gh-error.txt makes `gh pr view`
fail with that message, like gh does, and one with merge-error.txt does the same for `gh pr merge`.
The nth `gh pr view` answers with pr.<n>.json, or with the newest earlier one, so a fixture can play
CI finishing over time. `gh api .../compare/<base>...<sha>` answers with compare/<sha>.json when it
exists, and with compare.json otherwise. `gh api .../git/trees/<sha>?recursive=1` answers with
trees/<sha>.json, and `gh api .../commits/<sha>/status` with status.json. --jq is ignored: the
recorded files are already cut down to what the gate asks for.
"""

import os
import re
import sys

FIXTURE = os.environ["FAKE_GH_FIXTURE"]
WORK_DIR = os.environ["FAKE_GH_WORK_DIR"]
REPO = os.environ.get("FAKE_GH_REPO", "octo-org/octo-repo")


def recorded(*parts: str) -> str:
    with open(os.path.join(FIXTURE, *parts), encoding="utf-8") as file:
        return file.read()


def fail_with(filename: str) -> None:
    if os.path.exists(os.path.join(FIXTURE, filename)):
        sys.stderr.write(recorded(filename))
        sys.exit(1)


def record_write(args: list[str]) -> None:
    with open(os.path.join(WORK_DIR, "writes.log"), "a", encoding="utf-8") as log:
        log.write("gh " + " ".join(args) + "\n")


def recorded_pr_view() -> str:
    count_file = os.path.join(WORK_DIR, "pr-view-count")
    count = int(open(count_file).read()) + 1 if os.path.exists(count_file) else 1
    with open(count_file, "w") as file:
        file.write(str(count))
    view = "pr.json"
    for n in range(2, count + 1):
        if os.path.exists(os.path.join(FIXTURE, f"pr.{n}.json")):
            view = f"pr.{n}.json"
    return recorded(view)


def recorded_api(path: str) -> str:
    compare = re.search(r"/compare/[^.]+\.\.\.([0-9a-f]+)$", path)
    if compare:
        per_sha = os.path.join("compare", f"{compare.group(1)}.json")
        has_per_sha = os.path.exists(os.path.join(FIXTURE, per_sha))
        return recorded(per_sha) if has_per_sha else recorded("compare.json")
    tree = re.search(r"/git/trees/([0-9a-f]+)", path)
    if tree:
        return recorded("trees", f"{tree.group(1)}.json")
    if re.search(r"/commits/[0-9a-f]+/status", path):
        return recorded("status.json")
    if path.endswith("/reviews"):
        return recorded("reviews.json")
    if path.endswith("/commits"):
        return recorded("commits.json")
    raise LookupError(path)


def main(args: list[str]) -> None:
    command = " ".join(args[:2])
    if command == "repo view":
        print(f'{{"nameWithOwner":"{REPO}"}}')
    elif command == "pr view":
        fail_with("gh-error.txt")
        sys.stdout.write(recorded_pr_view())
    elif args[0] == "api" and not args[1].startswith("-"):
        sys.stdout.write(recorded_api(args[1]))
    elif command == "pr update-branch":
        record_write(args)
    elif command == "pr merge":
        fail_with("merge-error.txt")
        record_write(args)
    else:
        raise LookupError(" ".join(args))


try:
    main(sys.argv[1:])
except LookupError as error:
    sys.stderr.write(f"fake gh: unexpected command: gh {' '.join(sys.argv[1:])} ({error})\n")
    sys.exit(64)
